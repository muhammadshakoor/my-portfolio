# Copy to .env.local and fill in. Only the Web3Forms key is needed for a
# working site; everything else has a sensible default.

# Contact form — free access key from https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=

# Blog CMS (optional). Leave unset to serve posts from content/posts/*.md
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical site URL (optional). On Vercel, VERCEL_PROJECT_PRODUCTION_URL is
# used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=
